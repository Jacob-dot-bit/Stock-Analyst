# Copy to .env and fill in. The .env file is never committed.
# The application starts and works without any of these keys:
# the affected features simply disable themselves.

# Reference currency for portfolio totals
BASE_CURRENCY=EUR

# --- Optional: news and company profiles (free tier, 60 calls/min) ---
# https://finnhub.io/register
FINNHUB_API_KEY=

# --- Optional: official US fundamentals via SEC EDGAR ---
# Free and keyless, but the SEC requires a named User-Agent
# formatted as "First Last email@example.com". Without it EDGAR stays disabled.
SEC_USER_AGENT=

# --- Optional: qualitative synthesis (PAID) ---
# Billed per token plus a per-request fee. Used only on explicit
# demand, one instrument at a time, and cached.
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_CACHE_TTL_DAYS=7
