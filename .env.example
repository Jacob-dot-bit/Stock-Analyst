# Copier vers .env et remplir. Le fichier .env n'est jamais committé.
# L'application démarre et fonctionne sans aucune de ces clés :
# les fonctionnalités concernées se désactivent simplement.

# Devise de référence pour les totaux du portefeuille
BASE_CURRENCY=EUR

# --- Optionnel : actualités et profils (free tier 60 appels/min) ---
# https://finnhub.io/register
FINNHUB_API_KEY=

# --- Optionnel : fondamentaux officiels US via SEC EDGAR ---
# Gratuit et sans clé, mais la SEC exige un User-Agent nominatif
# au format "Nom Prenom email@exemple.com". Sans lui, EDGAR est désactivé.
SEC_USER_AGENT=

# --- Optionnel : synthèse qualitative (PAYANT) ---
# Facturé aux tokens + un frais par requête. Utilisé uniquement
# sur demande explicite, titre par titre, avec mise en cache.
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_CACHE_TTL_DAYS=7
