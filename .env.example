# Copy to .env and fill in. The .env file is never committed.
# The application starts and works without any of these keys:
# the affected features simply disable themselves.

# Reference currency for portfolio totals
BASE_CURRENCY=EUR

# --- Recommended: fallback price provider ---
# Yahoo needs no key but rate-limits hard, and a blocked IP can stay blocked for
# a long time. Twelve Data's free tier (email signup, no card) keeps refreshes
# working when that happens: 800 requests/day, 8/minute, worldwide coverage.
# https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# --- Recommended: Euronext coverage (French/Dutch ETFs and shares) ---
# Neither of the keyless sources covers French PEA ETFs: Frankfurt does not list
# them, and Yahoo — which does — blocks by IP. FMP advertises 250 requests/day on
# its free tier across Euronext, using the same .PA symbols this app derives.
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# --- Optional: official US fundamentals via SEC EDGAR ---
# Free and keyless, but the SEC requires a named User-Agent
# formatted as "First Last email@example.com". Without it EDGAR stays disabled.
SEC_USER_AGENT=

# --- Optional: qualitative synthesis (PAID) ---
# Billed per token plus a per-request fee. Used only on explicit
# demand, one instrument at a time, and cached.
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_CACHE_TTL_DAYS=7

# --- Phase 2+ : Additional price data sources (maximize coverage & failover) ---
# These sources provide redundancy when primary sources rate-limit.
# All are free tier with API keys; signup takes an email and no credit card.

# Polygon.io: US stocks + crypto, 5 req/min free tier
# Signup moved to massive.com (rebrand); the API itself is unchanged, still at
# api.polygon.io.
# https://massive.com/pricing
POLYGON_API_KEY=

# Alpha Vantage: Worldwide stocks, 5 req/min free tier
# https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=

# Tiingo: Worldwide stocks, 500 req/day free tier
# https://www.tiingo.com/account/api/token
TIINGO_API_KEY=

# Barchart OnDemand: Worldwide stocks, 400 req/day free tier
# https://www.barchart.com/ondemand
BARCHART_API_KEY=

# Intrinio: US + Canada stocks, 500 req/day free tier
# https://intrinio.com/account/api_keys
INTRINIO_API_KEY=

# EODHD: 150+ bourses mondiales, 20 req/day free tier
# https://eodhd.com/register
EODHD_API_KEY=

# Marketstack: World Trading Data's named successor (WTD's own API pointed
# here before shutting down). Free tier is thin — 100 requests/MONTH, not per
# day — so it sits near the end of the fallback chain, used only when nothing
# more generous covered an instrument.
# https://marketstack.com/product
MARKETSTACK_API_KEY=

# Stooq, Eoddata, Finviz are also integrated but need no key at all — nothing
# to configure here for them.
#
# IEX Cloud and Quandl are NOT integrated: both were verified live and found
# genuinely shut down with no viable free replacement (IEX Cloud refuses the
# TLS handshake; Quandl's free WIKI dataset was discontinued in 2018). See
# DEVLOG "Bug 2.5" and "Bug 2.6".
